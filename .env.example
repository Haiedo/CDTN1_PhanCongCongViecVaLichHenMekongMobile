# Copy to .env (cp .env.example .env) and edit. NEVER commit .env (it is in .gitignore).
# The values below are placeholders for a local demo, not real secrets.

# ---- Used by Docker (docker compose up) --------------------------------------
# Password of the PostgreSQL user "postgres" inside the container. Use letters and digits only
# (it is placed inside a connection URL). The database port is not exposed outside Docker.
POSTGRES_PASSWORD=change_me_demo_only
# Host port that serves the web UI and API (container port stays 3000). Change if 3000 is busy.
APP_PORT=3000

# ---- Used by Docker AND by "npm start" -----------------------------------------
# Key that signs login tokens (valid 60 minutes). Replace with your own long random string.
JWT_SECRET=change-this-secret-before-any-real-deployment
# Shared password of the 4 demo accounts (fake data, public in the README)
DEMO_PASSWORD=demo123

# ---- Used only when you run WITHOUT Docker (npm start / npm test on your machine) ---
# Replace matkhau_cua_ban with the password of your local PostgreSQL "postgres" user.
DATABASE_URL=postgresql://postgres:matkhau_cua_ban@localhost:5432/mekong_l4
TEST_DATABASE_URL=postgresql://postgres:matkhau_cua_ban@localhost:5432/mekong_l4_test
PORT=3000
